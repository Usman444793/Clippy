@inherits LayoutComponentBase
@layout Clippy.Components.Layout.MainLayout

<section class="clippy-manage-shell">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.75rem;">
        <div>
            <div class="eyebrow-pill" style="margin-bottom: 0.4rem;">
                <i class="fa-solid fa-user-shield"></i> Identity &bull; Passkeys &bull; TOTP 2FA &bull; GDPR Data Control
            </div>
            <h1 style="font-size: 2rem; font-weight: 800; color: var(--clippy-dark); margin: 0;">
                Account &amp; Security Center
            </h1>
            <p style="color: var(--clippy-muted); font-size: 0.9rem; margin: 0.25rem 0 0 0;">
                Manage your profile, WebAuthn Passkeys, Two-Factor Authentication, and GDPR personal data exports.
            </p>
        </div>
        <a href="/dashboard" class="btn-clippy-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to Link Workspace
        </a>
    </div>

    <div class="clippy-manage-layout-grid">
        <aside class="clippy-manage-nav-card">
            <ManageNavMenu />
        </aside>
        <div class="clippy-manage-content-card">
            @Body
        </div>
    </div>
</section>

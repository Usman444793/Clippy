@page "/Account/RegisterConfirmation"
@using Microsoft.AspNetCore.Identity
@using Clippy.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verify Your Email | Clippy Enterprise</PageTitle>

<section class="clippy-auth-container">
    <div class="clippy-auth-card" style="max-width: 660px; margin: 0 auto;">
        <div class="eyebrow-pill" style="margin-bottom: 0.65rem;">
            <i class="fa-solid fa-envelope-circle-check"></i> MailKit STARTTLS Verification Dispatched
        </div>
        <h1 style="font-size: 1.95rem; font-weight: 800; color: var(--clippy-dark); margin: 0 0 0.5rem 0;">
            Check your email to confirm your account
        </h1>
        <p style="color: var(--clippy-muted); font-size: 0.92rem; line-height: 1.65; margin-bottom: 1.5rem;">
            We sent a verification email to <strong>@Email</strong> via MailKit SMTP. Click the <strong>Verify Email Address</strong> button inside the email to activate your account.
        </p>

        <StatusMessage Message="@statusMessage" />

        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; padding-top: 1rem; border-top: 1px solid var(--clippy-border);">
            <a href="/Account/Login" style="color: var(--clippy-dark); font-weight: 700; text-decoration: none;">
                &larr; Return to Sign In
            </a>
            <a href="/Account/ResendEmailConfirmation" style="color: var(--clippy-green-text); font-weight: 600; text-decoration: none;">
                Didn't receive it? Resend email
            </a>
        </div>
    </div>
</section>

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Email is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = "Error finding user for the specified email address.";
        }
    }
}

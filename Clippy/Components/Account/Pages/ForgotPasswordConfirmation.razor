@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Password Reset Sent | Clippy Enterprise</PageTitle>

<section class="clippy-auth-container">
    <div class="clippy-auth-card" style="max-width: 640px; margin: 0 auto;">
        <div class="eyebrow-pill" style="margin-bottom: 0.65rem;">
            <i class="fa-solid fa-envelope-circle-check"></i> MailKit STARTTLS Recovery Dispatched
        </div>
        <h1 style="font-size: 1.9rem; font-weight: 800; color: var(--clippy-dark); margin: 0 0 0.5rem 0;">
            Check your email to reset your password
        </h1>
        <p role="alert" style="color: var(--clippy-muted); font-size: 0.92rem; line-height: 1.65; margin-bottom: 1.5rem;">
            If an account exists for that email address, we've sent a password recovery email containing a single-use cryptographic reset link.
        </p>

        <a href="/Account/Login" class="btn-clippy-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to Sign In
        </a>
    </div>
</section>

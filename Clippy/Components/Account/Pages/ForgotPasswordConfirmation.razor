@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Password Reset Dispatched | Clippy Enterprise</PageTitle>

<section class="clippy-auth-container">
    <div class="clippy-auth-card" style="max-width: 640px; margin: 0 auto;">
        <div class="eyebrow-pill" style="margin-bottom: 0.65rem;">
            <i class="fa-solid fa-envelope-circle-check"></i> Security Recovery Dispatched
        </div>
        <h1 style="font-size: 1.9rem; font-weight: 800; color: var(--clippy-dark); margin: 0 0 0.5rem 0;">
            Check your email to reset your password
        </h1>
        <p role="alert" style="color: var(--clippy-muted); font-size: 0.92rem; line-height: 1.65; margin-bottom: 1.5rem;">
            We've sent a Coursera-style HTML password recovery email containing a single-use cryptographic reset link.
        </p>

        <div style="background: var(--clippy-cream); border: 1px solid var(--clippy-border); border-radius: 1.25rem; padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
            <div>
                <strong style="display: block; font-size: 0.9rem; color: var(--clippy-dark);">Inspect your recovery email right now</strong>
                <span style="font-size: 0.8rem; color: var(--clippy-muted);">Open the Live Email Inbox to click the "Reset My Password" button.</span>
            </div>
            <a href="/mailbox" class="btn-clippy-green">
                <i class="fa-solid fa-inbox"></i> Open Live Email Inbox
            </a>
        </div>

        <a href="/Account/Login" class="btn-clippy-outline">
            <i class="fa-solid fa-arrow-left"></i> Back to Sign In
        </a>
    </div>
</section>

@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Clippy.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>GDPR &amp; Personal Data | Clippy Enterprise</PageTitle>

<div style="margin-bottom: 1.5rem;">
    <span class="eyebrow-pill" style="margin-bottom: 0.35rem;">
        <i class="fa-solid fa-database"></i> GDPR Data Portability &amp; Right to Erasure
    </span>
    <h3 style="font-size: 1.45rem; font-weight: 800; color: var(--clippy-dark); margin: 0;">Personal Data &amp; Privacy</h3>
    <p style="font-size: 0.85rem; color: var(--clippy-muted); margin: 0.25rem 0 0 0;">
        Export your account identity metadata as JSON or permanently erase your Clippy account.
    </p>
</div>

<StatusMessage />

<div style="background: var(--clippy-cream); border: 1px solid var(--clippy-border); border-radius: 1.25rem; padding: 1.5rem; margin-bottom: 1.25rem;">
    <h5 style="font-size: 1rem; font-weight: 800; margin: 0 0 0.4rem 0;">Export Account Archive (JSON)</h5>
    <p style="font-size: 0.85rem; color: var(--clippy-muted); margin-bottom: 1rem;">
        Download a machine-readable JSON archive containing your profile attributes, authentication providers, and registered passkeys.
    </p>
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <button class="btn-clippy-dark" type="submit">
            <i class="fa-solid fa-file-arrow-down"></i> Download Personal Data JSON
        </button>
    </form>
</div>

<div style="background: var(--clippy-danger-soft); border: 1px solid #FECACA; border-radius: 1.25rem; padding: 1.5rem;">
    <h5 style="font-size: 1rem; font-weight: 800; color: #991B1B; margin: 0 0 0.4rem 0;">
        <i class="fa-solid fa-triangle-exclamation me-1"></i> Danger Zone: Permanent Account Erasure
    </h5>
    <p style="font-size: 0.85rem; color: #7F1D1D; margin-bottom: 1rem;">
        Deleting this data will permanently remove your account, shortened links, and telemetry history. This action cannot be undone.
    </p>
    <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">
        <i class="fa-regular fa-trash-can me-1"></i> Delete Account Permanently
    </a>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}

@page "/Account/AccessDenied"

<PageTitle>Access Denied | Clippy Enterprise</PageTitle>

<section class="clippy-auth-container" style="max-width: 620px;">
    <div class="clippy-auth-card" style="text-align: center;">
        <div class="eyebrow-pill" style="background: var(--clippy-danger-soft); color: #991B1B;">
            <i class="fa-solid fa-ban"></i> HTTP 403 Forbidden
        </div>
        <h1 style="font-size: 1.9rem; font-weight: 800; color: var(--clippy-dark); margin-bottom: 0.5rem;">Access Denied</h1>
        <p style="color: var(--clippy-muted); margin-bottom: 1.5rem;">You do not have permission to access this protected resource.</p>
        <div style="display: flex; justify-content: center; gap: 0.75rem;">
            <a href="/dashboard" class="btn-clippy-dark">Go to Dashboard</a>
            <a href="/Account/Login" class="btn-clippy-outline">Switch Account</a>
        </div>
    </div>
</section>

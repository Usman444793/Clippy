@page "/mailbox"
@rendermode InteractiveServer
@using Clippy.Services.Email
@inject IClippyEmailService EmailService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Email Outbox &amp; SMTP Console | Clippy Enterprise</PageTitle>

<section style="max-width: 1240px; margin: 1.5rem auto 4rem auto; padding: 0 1.5rem;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.5rem;">
        <div>
            <div class="eyebrow-pill" style="margin-bottom: 0.45rem;">
                <i class="fa-solid fa-envelope-circle-check"></i> Coursera-Grade HTML Transactional Email Engine &bull; TLS SMTP + Live Outbox
            </div>
            <h1 style="font-size: 2rem; font-weight: 800; color: var(--clippy-dark); margin: 0;">
                Transactional Email Center &amp; Live Inbox
            </h1>
            <p style="color: var(--clippy-muted); font-size: 0.9rem; margin: 0.25rem 0 0 0;">
                Inspect verification links, 6-digit HMAC OTP codes, and password reset emails in real time, or connect your live SMTP server (Gmail, SendGrid, SES).
            </p>
        </div>
        <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
            <button class="btn-clippy-outline" @onclick="() => showSmtpModal = true">
                <i class="fa-solid fa-server"></i> Configure Live SMTP
            </button>
            <button class="btn-clippy-outline" @onclick="SendSampleEmailAsync" disabled="@isSendingSample">
                <i class="fa-solid @(isSendingSample ? "fa-spinner fa-spin" : "fa-paper-plane")"></i> Send Test Email
            </button>
            <button class="btn-clippy-dark" @onclick="RefreshMailboxAsync">
                <i class="fa-solid fa-arrows-rotate @(isLoading ? "fa-spin" : "")"></i> Refresh Inbox
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusBanner))
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between mb-3" style="padding: 0.85rem 1.25rem;">
            <span><i class="fa-solid fa-circle-check me-2"></i> @statusBanner</span>
            <button type="button" style="background:none;border:none;font-weight:800;cursor:pointer;" @onclick="() => statusBanner = null">&times;</button>
        </div>
    }

    <div class="mailbox-grid">
        <!-- Left Column: Message List -->
        <div class="mailbox-list-card">
            <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--clippy-border); display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 800; font-size: 0.92rem; color: var(--clippy-dark);">
                    Dispatched Emails (@emails.Count)
                </span>
                @if (emails.Any(x => !x.IsRead))
                {
                    <button class="btn-clippy-outline" style="padding: 0.25rem 0.65rem; font-size: 0.72rem;" @onclick="MarkAllRead">
                        Mark all read
                    </button>
                }
            </div>

            @if (isLoading)
            {
                <div style="padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton-card" style="padding: 1rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span class="skeleton skeleton-pill" style="width: 90px; height: 1.15rem;"></span>
                                <span class="skeleton skeleton-line" style="width: 55px; height: 0.7rem; margin: 0;"></span>
                            </div>
                            <div class="skeleton skeleton-line" style="width: 85%; height: 0.9rem;"></div>
                            <div class="skeleton skeleton-line" style="width: 60%; height: 0.75rem; margin-bottom: 0;"></div>
                        </div>
                    }
                </div>
            }
            else if (!emails.Any())
            {
                <div style="padding: 3rem 1.5rem; text-align: center; color: var(--clippy-muted);">
                    <i class="fa-regular fa-envelope-open fa-2x mb-2" style="color: var(--clippy-border);"></i>
                    <p style="font-weight: 700; color: var(--clippy-dark); margin-bottom: 0.25rem;">No transactional emails yet</p>
                    <p style="font-size: 0.8rem; margin-bottom: 1rem;">
                        Register a new account, request a 6-digit OTP code, reset a password, or click "Send Test Email" above.
                    </p>
                    <button class="btn-clippy-green" style="padding: 0.55rem 1.1rem; font-size: 0.8rem;" @onclick="SendSampleEmailAsync">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Generate Coursera-Style Preview Email
                    </button>
                </div>
            }
            else
            {
                <div style="max-height: 620px; overflow-y: auto;">
                    @foreach (var item in emails)
                    {
                        var isSelected = selectedEmail?.Id == item.Id;
                        <button type="button"
                                class="mailbox-item-btn @(isSelected ? "active" : "") @(!item.IsRead ? "unread" : "")"
                                @onclick="() => SelectEmail(item)">
                            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 0.35rem;">
                                <span class="mailbox-category-badge">@item.Category</span>
                                <span style="font-size: 0.72rem; color: var(--clippy-muted); font-family: var(--font-mono);">
                                    @item.SentAtUtc.ToString("HH:mm:ss") UTC
                                </span>
                            </div>
                            <div style="font-weight: @(item.IsRead ? "600" : "800"); font-size: 0.88rem; color: var(--clippy-dark); text-align: left; margin-bottom: 0.2rem;">
                                @if (!item.IsRead)
                                {
                                    <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--clippy-green);margin-right:6px;"></span>
                                }
                                @item.Subject
                            </div>
                            <div style="font-size: 0.76rem; color: var(--clippy-muted); text-align: left; display: flex; justify-content: space-between; width: 100%;">
                                <span>To: @item.ToEmail</span>
                                @if (item.DeliveredViaSmtp)
                                {
                                    <span style="color: var(--clippy-green-text); font-weight: 700;"><i class="fa-solid fa-check-double"></i> SMTP</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Right Column: Rendered HTML Email Preview -->
        <div class="mailbox-preview-card">
            @if (isLoading)
            {
                <div style="padding: 2rem;">
                    <div class="skeleton skeleton-pill" style="width: 140px; margin-bottom: 1rem;"></div>
                    <div class="skeleton skeleton-title" style="width: 70%; margin-bottom: 0.75rem;"></div>
                    <div class="skeleton skeleton-line" style="width: 45%; margin-bottom: 2rem;"></div>
                    <div class="skeleton" style="width: 100%; height: 340px; border-radius: 1.25rem;"></div>
                </div>
            }
            else if (selectedEmail is null)
            {
                <div style="padding: 4.5rem 2rem; text-align: center; color: var(--clippy-muted);">
                    <i class="fa-solid fa-envelope-open-text fa-3x mb-3" style="color: var(--clippy-border);"></i>
                    <h4 style="font-weight: 800; color: var(--clippy-dark);">Select an email to inspect</h4>
                    <p style="font-size: 0.88rem; max-width: 420px; margin: 0.5rem auto 0 auto;">
                        Every verification link, password reset token, and 6-digit OTP code is rendered here in its responsive Coursera-style HTML template.
                    </p>
                </div>
            }
            else
            {
                <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--clippy-border); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; background: var(--clippy-white);">
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                            <span class="mailbox-category-badge">@selectedEmail.Category</span>
                            <span style="font-size: 0.76rem; color: var(--clippy-muted);">
                                @selectedEmail.DeliveryStatusNote
                            </span>
                        </div>
                        <h3 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: var(--clippy-dark);">@selectedEmail.Subject</h3>
                        <div style="font-size: 0.8rem; color: var(--clippy-muted); margin-top: 0.15rem;">
                            To: <strong>@selectedEmail.ToEmail</strong> &bull; Dispatched @selectedEmail.SentAtUtc.ToString("MMM dd, yyyy HH:mm:ss") UTC
                        </div>
                    </div>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        @if (!string.IsNullOrWhiteSpace(selectedEmail.OtpCode))
                        {
                            <button class="btn-clippy-green" style="padding: 0.45rem 1rem; font-size: 0.8rem;" @onclick="() => CopyOtpAsync(selectedEmail.OtpCode!)">
                                <i class="fa-regular fa-copy"></i> Copy OTP (@selectedEmail.OtpCode)
                            </button>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedEmail.ActionUrl))
                        {
                            <a href="@selectedEmail.ActionUrl" class="btn-clippy-green" style="padding: 0.45rem 1rem; font-size: 0.8rem;">
                                <i class="fa-solid fa-bolt"></i> @(selectedEmail.ActionLabel ?? "Execute Action Link")
                            </a>
                        }
                    </div>
                </div>
                <div style="padding: 1rem; background: #F7F3EE;">
                    <iframe title="Rendered HTML Email"
                            srcdoc="@selectedEmail.HtmlBody"
                            style="width: 100%; min-height: 540px; border: none; border-radius: 1rem; background: #F7F3EE;">
                    </iframe>
                </div>
            }
        </div>
    </div>
</section>

@if (showSmtpModal)
{
    <div class="clippy-modal-backdrop" @onclick="() => showSmtpModal = false">
        <div class="clippy-modal-card" style="max-width: 540px; text-align: left;" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <div>
                    <span class="eyebrow-pill" style="margin-bottom: 0.25rem;">Live SMTP Relay Configuration</span>
                    <h4 style="margin: 0; font-weight: 800;">Connect External Email Provider</h4>
                </div>
                <button style="background:none;border:none;font-size:1.5rem;cursor:pointer;" @onclick="() => showSmtpModal = false">&times;</button>
            </div>
            <p style="font-size: 0.83rem; color: var(--clippy-muted); margin-bottom: 1rem;">
                Enter your SMTP credentials (e.g., <code>smtp.gmail.com</code> port <code>587</code> with a 16-character Google App Password, or SendGrid/Mailgun/SES) to deliver real emails to external inboxes in addition to the Live Outbox.
            </p>
            <div class="mb-3">
                <label class="form-label" style="font-size: 0.78rem; font-weight: 700;">SMTP Host</label>
                <input type="text" class="form-control" placeholder="smtp.gmail.com" @bind="smtpModel.SmtpHost" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" style="font-size: 0.78rem; font-weight: 700;">SMTP Port</label>
                    <input type="number" class="form-control" @bind="smtpModel.SmtpPort" />
                </div>
                <div class="col-6 d-flex align-items-end pb-2">
                    <label style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                        <input type="checkbox" class="form-check-input" @bind="smtpModel.EnableSsl" /> Enable STARTTLS / SSL
                    </label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" style="font-size: 0.78rem; font-weight: 700;">SMTP Username / Email</label>
                <input type="email" class="form-control" placeholder="yourname@gmail.com" @bind="smtpModel.SmtpUser" />
            </div>
            <div class="mb-3">
                <label class="form-label" style="font-size: 0.78rem; font-weight: 700;">SMTP Password / App Password</label>
                <input type="password" class="form-control" placeholder="16-digit Google App Password or API Key" @bind="smtpModel.SmtpPassword" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" style="font-size: 0.78rem; font-weight: 700;">From Email</label>
                    <input type="email" class="form-control" @bind="smtpModel.FromEmail" />
                </div>
                <div class="col-6">
                    <label class="form-label" style="font-size: 0.78rem; font-weight: 700;">From Name</label>
                    <input type="text" class="form-control" @bind="smtpModel.FromName" />
                </div>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 0.65rem; margin-top: 1.25rem;">
                <button class="btn-clippy-outline" @onclick="() => showSmtpModal = false">Cancel</button>
                <button class="btn-clippy-green" @onclick="SaveSmtpSettings">
                    <i class="fa-solid fa-floppy-disk"></i> Save SMTP Configuration
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? FilterEmail { get; set; }

    private IReadOnlyList<DispatchedEmailMessage> emails = [];
    private DispatchedEmailMessage? selectedEmail;
    private EmailSettingsOptions smtpModel = new();
    private bool isLoading = true;
    private bool isSendingSample;
    private bool showSmtpModal;
    private string? statusBanner;

    protected override async Task OnInitializedAsync()
    {
        smtpModel = EmailService.GetCurrentSettings();
        EmailService.OnMailboxUpdated += HandleMailboxUpdated;
        await RefreshMailboxAsync();
    }

    private async Task RefreshMailboxAsync()
    {
        isLoading = true;
        StateHasChanged();
        await Task.Delay(320); // Smooth shimmer skeleton transition
        emails = EmailService.GetRecentEmails(FilterEmail);
        if (selectedEmail is null && emails.Any())
        {
            selectedEmail = emails[0];
            EmailService.MarkAsRead(selectedEmail.Id);
            emails = EmailService.GetRecentEmails(FilterEmail);
        }
        isLoading = false;
    }

    private void SelectEmail(DispatchedEmailMessage item)
    {
        EmailService.MarkAsRead(item.Id);
        emails = EmailService.GetRecentEmails(FilterEmail);
        selectedEmail = emails.FirstOrDefault(x => x.Id == item.Id) ?? item;
    }

    private void MarkAllRead()
    {
        EmailService.MarkAllAsRead();
        emails = EmailService.GetRecentEmails(FilterEmail);
    }

    private async Task SendSampleEmailAsync()
    {
        isSendingSample = true;
        try
        {
            var recipient = !string.IsNullOrWhiteSpace(FilterEmail)
                ? FilterEmail!
                : (!string.IsNullOrWhiteSpace(smtpModel.SmtpUser) ? smtpModel.SmtpUser : "founder@clippy.io");
            var msg = await EmailService.SendCustomTemplateEmailAsync(
                toEmail: recipient,
                subject: "Welcome to Clippy Enterprise — Verify Your Security Workspace",
                category: "Coursera-Style Verification",
                headline: "Confirm your Clippy Enterprise Identity",
                introParagraph: "Thank you for testing Clippy Enterprise! Your account is protected by 64-bit Snowflake Base62 link isolation, FIDO2 WebAuthn Passkeys, and HMAC-SHA256 verification codes.",
                actionUrl: Navigation.ToAbsoluteUri("/dashboard").ToString(),
                actionLabel: "Launch My Link Workspace",
                otpCode: Random.Shared.Next(100000, 999999).ToString(),
                securityFooterNote: "Dispatched via Clippy Enterprise Transactional Email Engine."
            );
            emails = EmailService.GetRecentEmails(FilterEmail);
            selectedEmail = msg;
            statusBanner = msg.DeliveredViaSmtp
                ? $"Email delivered via SMTP to {recipient} and captured in Live Inbox!"
                : $"Coursera-style HTML email generated for {recipient}!";
        }
        finally
        {
            isSendingSample = false;
        }
    }

    private void SaveSmtpSettings()
    {
        EmailService.UpdateRuntimeSmtpSettings(smtpModel);
        showSmtpModal = false;
        statusBanner = string.IsNullOrWhiteSpace(smtpModel.SmtpHost)
            ? "Switched to Local Live Outbox mode."
            : $"Live SMTP relay configured ({smtpModel.SmtpHost}:{smtpModel.SmtpPort}). All verification & OTP emails will now be sent over SMTP!";
    }

    private async Task CopyOtpAsync(string code)
    {
        await JS.InvokeAsync<bool>("clippyInterop.copyText", code);
        statusBanner = $"Copied 6-digit verification code {code} to clipboard!";
    }

    private void HandleMailboxUpdated()
    {
        _ = InvokeAsync(() =>
        {
            emails = EmailService.GetRecentEmails(FilterEmail);
            if (selectedEmail is null && emails.Any())
            {
                selectedEmail = emails[0];
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EmailService.OnMailboxUpdated -= HandleMailboxUpdated;
    }
}

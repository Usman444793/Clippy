@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>404 - Link or Route Not Found | Clippy Enterprise</PageTitle>

<section class="notfound-wrapper">
    <div class="notfound-card">
        <div class="eyebrow-pill">
            <i class="fa-solid fa-satellite-dish"></i> HTTP 404 &bull; L1 Negative Cache Guard Active
        </div>

        <div class="notfound-code-badge">
            4<span>0</span>4
        </div>

        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--clippy-dark); margin: 0 0 0.75rem 0;">
            This short link or page doesn't exist
        </h1>
        <p style="color: var(--clippy-muted); font-size: 0.96rem; max-width: 520px; margin: 0 auto 1.5rem auto; line-height: 1.65;">
            The shortened alias may have expired, been deactivated by our scheduled janitor worker, or the URL was mistyped.
        </p>

        <div class="notfound-terminal">
            <div style="display: flex; gap: 0.4rem; margin-bottom: 0.65rem;">
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #EF4444;"></span>
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #F59E0B;"></span>
                <span style="width: 10px; height: 10px; border-radius: 50%; background: #10B981;"></span>
            </div>
            <div><span style="color: #73D167;">$ clippy-router</span> --resolve "@Navigation.Uri"</div>
            <div style="color: #94A3B8; margin-top: 0.25rem;">&gt; L1 IMemoryCache Lookup: <strong style="color: #F87171;">MISS / NEGATIVE_CACHE_ENTRY (30s TTL)</strong></div>
            <div style="color: #94A3B8;">&gt; Status: <strong style="color: #FBBF24;">404 NotFound</strong> (Stampede Lock Released)</div>
        </div>

        <div style="display: flex; justify-content: center; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.75rem;">
            <a href="/" class="btn-clippy-green">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Shorten a New URL
            </a>
            <a href="/dashboard" class="btn-clippy-dark">
                <i class="fa-solid fa-chart-pie"></i> Open Analytics Dashboard
            </a>
            <a href="/Account/Login" class="btn-clippy-outline">
                <i class="fa-solid fa-user-shield"></i> Sign In
            </a>
        </div>
    </div>
</section>
